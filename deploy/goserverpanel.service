[Unit]
Description=GoServerPanel
After=network-online.target nginx.service
Wants=network-online.target

[Service]
ExecStart=/usr/local/bin/goserverpanel -config /etc/goserverpanel/config.yaml
Restart=on-failure
RestartSec=3
# Панель управляет системой и работает от root (см. раздел «Безопасность» в README).
User=root

[Install]
WantedBy=multi-user.target
